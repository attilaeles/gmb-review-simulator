{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow stage quality checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "traceability": {
      "$ref": "synthetic_reviews.schema.json#/$defs/traceability"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ]
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "passed",
        "failed",
        "invalidated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "version",
          "sha256"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "version",
          "sha256"
        ]
      }
    },
    "quality_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "warning",
              "pending"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "result",
          "blocking",
          "details"
        ]
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "record_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "required",
        "record_path",
        "record_sha256"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "traceability",
    "checkpoint_id",
    "supersedes_checkpoint_id",
    "project_id",
    "run_id",
    "stage",
    "batch_id",
    "status",
    "created_at",
    "inputs",
    "outputs",
    "quality_checks",
    "approval",
    "blockers",
    "next_action"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "1"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          },
          "quality_checks": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "result": {
                      "enum": [
                        "passed",
                        "warning"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "blocking": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "result": {
                        "const": "passed"
                      }
                    }
                  }
                }
              ]
            }
          },
          "approval": {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "record_path": {
                  "type": "string",
                  "minLength": 1
                },
                "record_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  ],
  "x-artifact-metadata": {
    "version": "1.0.0",
    "commit_text": "Define durable stage checkpoints with quality and approval gates",
    "change_history": [
      {
        "version": "1.0.0",
        "parent_version": null,
        "changed_at": "2026-10-15T09:25:06.292193+00:00",
        "commit_text": "Define durable stage checkpoints with quality and approval gates"
      }
    ]
  }
}
